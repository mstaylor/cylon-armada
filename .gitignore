# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
*.pyx.c

# Cython build artifacts
target/shared/scripts/simd/*.c
target/shared/scripts/simd/*.html

# Node.js
node_modules/
package-lock.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Experiment results (large data, not versioned)
target/experiments/results/

# AWS credentials (never commit)
.env
*.pem
credentials.json

# Jupyter
.ipynb_checkpoints/

# Docker
docker/*.tar
docker/wasm/

# Terraform — local provider caches, state, and plans (never versioned)
# .terraform/ holds downloaded provider binaries (hundreds of MB each) and must
# not be committed; state files can contain secrets. Applies to all modules
# (terraform/, terraform-ec2/, terraform-gpu/).
# Note: .terraform.lock.hcl is intentionally NOT ignored — the provider
# dependency lock file should be committed so runs are reproducible.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.worktrees/

# superpowers SDD scratch, not part of the project
.superpowers/

# Lambda deployment packages built by terraform's archive_file at plan time.
# The bootstrap binary itself is tracked; the zip is regenerated and is 14 MB.
target/aws/scripts/lambda/**/*.zip

# Local operator variable files. The .example stays tracked as the reference.
terraform.tfvars
*.auto.tfvars
