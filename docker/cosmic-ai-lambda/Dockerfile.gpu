ARG BASE_IMAGE=qad5gv/cosmic-ai-lambda:arm64
FROM ${BASE_IMAGE}

ARG TORCH_VERSION=2.5.0
ARG TORCHVISION_VERSION=0.20.0
ARG TORCHAUDIO_VERSION=2.5.0
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
ARG TORCH_CUDA_VERSION=12.4

RUN . /opt/conda/etc/profile.d/conda.sh && \
    conda activate cylon_dev && \
    pip install --no-cache-dir --force-reinstall --no-deps \
        "torch==${TORCH_VERSION}" "torchvision==${TORCHVISION_VERSION}" "torchaudio==${TORCHAUDIO_VERSION}" \
        --index-url "${TORCH_INDEX_URL}" && \
    python -c "import torch, torchvision, timm; \
assert torch.__version__.split('+')[0] == '${TORCH_VERSION}', torch.__version__; \
assert torchvision.__version__.split('+')[0] == '${TORCHVISION_VERSION}', torchvision.__version__; \
assert torch.version.cuda == '${TORCH_CUDA_VERSION}', torch.version.cuda; \
print('torch', torch.__version__, 'cuda', torch.version.cuda, 'timm', timm.__version__)"